object MainForm: TMainForm
  Left = 300
  Height = 600
  Top = 100
  Width = 800
  Caption = 'Pixie Demo'
  Position = poScreenCenter
  OnCreate = FormCreate
  object UrlPanel: TPanel
    Left = 0
    Height = 36
    Top = 0
    Width = 800
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 36
    ClientWidth = 800
    TabOrder = 0
    object BtnOpen: TSpeedButton
      Left = 4
      Height = 24
      Top = 6
      Width = 130
      Align = alLeft
      BorderSpacing.Left = 4
      BorderSpacing.Top = 6
      BorderSpacing.Bottom = 6
      Caption = 'Load HTML from file'
      OnClick = BtnOpenClick
    end
    object BtnGo: TButton
      Left = 746
      Height = 24
      Top = 6
      Width = 50
      Align = alRight
      BorderSpacing.Top = 6
      BorderSpacing.Right = 4
      BorderSpacing.Bottom = 6
      Caption = 'Go'
      OnClick = BtnGoClick
      TabOrder = 1
    end
    object UrlEdit: TEdit
      Left = 142
      Height = 24
      Top = 6
      Width = 604
      Align = alClient
      BorderSpacing.Left = 8
      BorderSpacing.Top = 6
      BorderSpacing.Right = 8
      BorderSpacing.Bottom = 6
      TabOrder = 0
      TextHint = '...or try a simple web-site here'
      OnKeyPress = UrlEditKeyPress
    end
  end
  object StatusBar: TStatusBar
    Left = 0
    Height = 23
    Top = 577
    Width = 800
    Panels = <
      item
        Width = 200
        Text = 'Parse: —'
      end
      item
        Width = 200
        Text = 'Paint: —'
      end>
    SimplePanel = False
  end
  object PixieHtmlView: TPixieHtmlView
    Left = 0
    Height = 541
    Top = 36
    Width = 800
    Align = alClient
    Color = clWhite
    OnAnchorClick = ViewAnchorClick
    OnElementClick = ViewElementClick
    OnFetchUrl = FetchUrl
    OnBeforeParse = ViewBeforeParse
    OnAfterParse = ViewAfterParse
    OnBeforePaint = ViewBeforePaint
    OnAfterPaint = ViewAfterPaint
  end
end
