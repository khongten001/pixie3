<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="Pixie.Package.Lazarus"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../source"/>
        <UnitOutputDirectory Value="../lib/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Pixie — HTML/CSS rendering engine for Free Pascal"/>
    <License Value="MIT"/>
    <Version Major="1"/>
    <Files>
      <Item>
        <Filename Value="../source/Pixie.Background.pas"/>
        <UnitName Value="Pixie.Background"/>
      </Item>
      <Item>
        <Filename Value="../source/Pixie.Borders.pas"/>
        <UnitName Value="Pixie.Borders"/>
      </Item>
      <!-- Platform canvas units excluded from the package:
           they are compiled via the project unit search path
           for the target OS only.
           - Pixie.Canvas.D2D.pas (Windows)
           - Pixie.Canvas.Cairo.pas (Linux)
           - Pixie.Canvas.CG.pas (macOS) -->
      <Item>
        <Filename Value="../source/Pixie.Canvas.pas"/>
        <UnitName Value="Pixie.Canvas"/>
      </Item>
